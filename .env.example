# Apaleo Simple Client (Client Credentials Grant), Scopes:
# reservations.read reservations.manage offers.read setup.read folios.read
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=

# Secret for signing admin session JWTs (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Vercel KV (Upstash Redis) — set automatically when you link Vercel KV to
# this project. Leave empty for local development: the app falls back to a
# local JSON file at .data/db.json automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Slack Incoming Webhook URL. When set, the team is notified in
# Slack whenever a guest submits a request-only ("Auf Anfrage") extra. Leave
# empty to disable Slack notifications entirely (requests are still stored
# and guests still get a confirmation either way).
SLACK_REQUEST_WEBHOOK_URL=

# Optional: overrides the app's own public base URL used to build absolute
# links (e.g. the "Anfrage bearbeiten" button in Slack notifications).
# Leave empty in Vercel — VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL are used
# automatically. Only set this for a custom domain that differs from those.
APP_BASE_URL=

# Internal STAY bridge (/api/stay/v1/*, see lib/stayBridge). OFF unless all
# four are set; leave empty in production until the bridge is approved.
# STAY_BRIDGE_SECRET is shared with STAY's EXTRAS_BRIDGE_SECRET (>= 32 chars,
# server-side only). Staging: STAY_BRIDGE_PROPERTY_IDS=TEST.
STAY_BRIDGE_ENABLED=
STAY_BRIDGE_SECRET=
STAY_BRIDGE_TENANT=
STAY_BRIDGE_PROPERTY_IDS=
