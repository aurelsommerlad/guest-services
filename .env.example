# Apaleo Simple Client (Client Credentials Grant), Scopes:
# reservations.read reservations.manage offers.read properties.read folios.read
APALEO_CLIENT_ID=
APALEO_CLIENT_SECRET=

# Secret for signing admin session JWTs (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Vercel KV (Upstash Redis) — set automatically when you link Vercel KV to
# this project. Leave empty for local development: the app falls back to a
# local JSON file at .data/db.json automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
